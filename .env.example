# ==============================================================================
# RentalKH Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing real production credentials to source control.
# ==============================================================================

# Application Environment (development | production | testing)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Primary Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rentalkh
DB_USER=root
DB_PASS=

# Optional Remote Fallback Database (Leave blank if not used)
DB_FALLBACK_HOST=
DB_FALLBACK_USER=
DB_FALLBACK_PASS=
DB_FALLBACK_NAME=

# Security & Session Settings
SESSION_LIFETIME_SECONDS=86400
SESSION_SECURE_COOKIE=false

# Operational Defaults
RESERVATION_EXPIRY_HOURS=24
MIN_RENTAL_DAYS=1
LATE_FEE_PER_HOUR=10.00
LATE_GRACE_PERIOD_MINUTES=30
FUEL_FEE_PER_QUARTER=15.00
CANCELLATION_CUTOFF_HOURS=24
CANCELLATION_FEE_FIXED=10.00
REQUIRE_DOCUMENTS_FOR_HANDOVER=1
REQUIRE_DEPOSIT_FOR_HANDOVER=1
